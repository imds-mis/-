POSTGRES_PASSWORD=imds-local-change-me
DATABASE_URL=postgresql+psycopg://imds:imds-local-change-me@postgres:5432/imds_documents
STORAGE_ROOT=/var/lib/imds-documents

QR_SIGNING_SECRET=replace-with-at-least-32-random-random-bytes
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173
PORT=8080

# Real IMDS upstream. Required for real patients/practitioners.
MIS_UPSTREAM_URL=https://mis.imds.kz
MIS_AUTH_TOKEN=

# Real conversation speech pipeline. Required for "Начать прием".
# Service contract:
# POST /transcribe with audio body + X-Session-ID + X-Chunk-ID -> {"turns":[{"speaker":"doctor|patient","text":"..."}]}
# POST /finalize with X-Session-ID -> same shape with final diarized transcript.
SPEECH_PIPELINE_URL=http://host.docker.internal:9000

# Real clinical extraction endpoint. OpenAI-compatible /chat/completions API.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=local-real-provider-key
LLM_MODEL=qwen3:8b

# Optional separate STT endpoint only for field-level dictation.
STT_URL=

# Frontend
VITE_API_BASE_URL=http://localhost:8080
VITE_TENANT_ID=
VITE_USER_ID=
VITE_BRANCH_ID=
VITE_PRACTITIONER_ID=
VITE_SPECIALTY_CODE=
