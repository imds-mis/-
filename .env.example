# Local database / storage
POSTGRES_PASSWORD=imds-local-change-me
DATABASE_URL=postgresql+psycopg://imds:imds-local-change-me@postgres:5432/imds_documents
STORAGE_ROOT=/var/lib/imds-documents

# Local document verification
QR_SIGNING_SECRET=replace-with-a-long-random-secret
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173

# Real MIS data source
MIS_UPSTREAM_URL=https://mis.imds.kz
MIS_AUTH_TOKEN=replace-with-valid-mis-bearer-token

# Real speech recognition + speaker diarization service.
# Must expose:
# POST /transcribe  with raw audio and X-Session-ID / X-Chunk-ID
# POST /finalize    with X-Session-ID
# JSON response: {"turns":[{"speaker":"doctor|patient","text":"...","confidence":0.95}]}
SPEECH_PIPELINE_URL=http://host.docker.internal:9000

# Real OpenAI-compatible LLM endpoint for structured clinical extraction.
# For a local model this can be an OpenAI-compatible server running on the host.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=local-real-model
LLM_MODEL=qwen2.5:7b-instruct

# Legacy single-field STT is optional.
STT_URL=

# Optional frontend default context. Real UUIDs only.
VITE_TENANT_ID=
VITE_USER_ID=
VITE_BRANCH_ID=
VITE_PRACTITIONER_ID=
VITE_SPECIALTY_CODE=
